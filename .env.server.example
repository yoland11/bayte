# Names only. Do not put real secrets in this tracked template.
# Provision Vercel Production ONLY after explicit approval.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BEITY_CANONICAL_EMAIL=
# Server-managed random internal credential for the EXISTING canonical user.
# Never request it from the owner or use the PIN as this credential.
# Production rotation/provisioning requires separate explicit approval.
BEITY_CANONICAL_PASSWORD=
BEITY_PIN_ARGON2_HASH=
BEITY_RATE_LIMIT_SECRET=

# Direct server-controlled grant; no OTP/recovery bootstrap capability is issued.
# Retired existing_user_otp is rejected, with no silent fallback.
BEITY_SESSION_ISSUER=server_password
